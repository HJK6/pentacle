    "agent_required": [
      "stream_id",
      "session_generation",
      "display_name",
      "role",
      "objective",
      "state",
      "model",
      "since"
    ],
    "agent_nullable": [
      "role",
      "objective",
      "model",
      "since"
    ],
    "agent_state": [
      "working",
      "idle",
      "blocked",
      "done"
    ],
    "timestamp": "RFC3339 UTC; since is state-transition time or null",
    "childless": "omit agents",
    "order": "created_at,stream_id",
    "thread_limit": {
      "default": 25,
      "min": 1,
      "max": 50,
      "max_response_utf8_bytes": 65536,
      "max_text_utf8_bytes": 8192
    },
    "cursor": "base64url JSON v1, no padding; binds pair/generations and exclusive before_seq; decode then reauthorize, never treat cursor as auth",
    "thread_row_fields": [
      "row_id",
      "ref_id",
      "ts",
      "direction",
      "kind",
      "text",
      "truncated"
    ],
    "direction": [
      "parent_to_child",
      "child_to_parent"
    ],
    "kinds": [
      "brief",
      "tell",
      "report"
    ],
    "page_order": "Newest page first; rows within each page ascending committed sequence; next_cursor loads older entries",
    "question_caps": {
      "title": 90,
      "paragraph": 300,
      "total": 1200,
      "lines_per_block": 3,
      "option_label": 40,
      "note": 100,
      "max_options": 5
    },
    "answer": "prompt.answer {request_id,question_id,selections?,text?}; same serializer on both surfaces",
    "spawn_fixture_precondition": "Seed the existing spawn catalog with fixture-catalog-v1 and the named valid model/effort; desktop_manual is the existing mobile wire profile identifier, not a client implementation scope."
