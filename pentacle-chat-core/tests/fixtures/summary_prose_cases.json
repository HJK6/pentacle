{
  "limit": 160,
  "abbreviations": [
    "e.g.",
    "i.e.",
    "vs.",
    "etc."
  ],
  "patterns": {
    "label": "^\\*\\*(Status|Next action)\\*\\*\\s*[—–-]\\s*(.*)$",
    "fence": "^\\s*(`{3,}|~{3,})",
    "terminal": "[.!?](?=\\s|$)",
    "semicolon": ";",
    "hex": "(?i)(?=[0-9a-f]*[a-f])[0-9a-f]{8,}",
    "seat": "\\w+:v2-[0-9a-fA-F]+",
    "work_id": "(?:spec_|work_)\\w+",
    "path": "(^|\\s)[\\w./-]*/[\\w.-]+\\.[a-z]{1,5}\\b",
    "joined_token": "[A-Za-z]{3,}[0-9]{2,}[0-9A-Za-z]*"
  },
  "cases": [
    {
      "name": "template_status",
      "label": "**Status** — Backlog, requirements not yet gathered.",
      "lint_ok": true,
      "daemon_line": "Backlog, requirements not yet gathered."
    },
    {
      "name": "template_next_action",
      "label": "**Status** — Gather requirements with the user and fill the spec.",
      "lint_ok": true,
      "daemon_line": "Gather requirements with the user and fill the spec."
    },
    {
      "name": "old_template",
      "label": "**Status** — backlog; requirements not yet gathered.",
      "lint_ok": false,
      "daemon_line": null
    },
    {
      "name": "multiple_sentences",
      "label": "**Status** — Tests pass. Review the result.",
      "lint_ok": false,
      "daemon_line": "Tests pass."
    },
    {
      "name": "abbreviation",
      "label": "**Status** — Review examples, e.g. the short label.",
      "lint_ok": true,
      "daemon_line": "Review examples, e.g. the short label."
    },
    {
      "name": "other_abbreviations",
      "label": "**Status** — Compare checks, i.e. local vs. remote, etc. before release.",
