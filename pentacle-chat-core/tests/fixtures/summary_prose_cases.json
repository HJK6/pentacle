{
  "patterns": {
    "label": "^\\*\\*(Status|Next action|Blockers)\\*\\*[ \\t]*[—–-][ \\t]*(.*)$",
    "fence": "^\\s*(`{3,}|~{3,})",
    "semicolon": ";",
    "hex": "(?i)(?=[0-9a-f]*[a-f])[0-9a-f]{8,}",
    "seat": "\\w+:v2-[0-9a-fA-F]+",
    "work_id": "(?:spec_|work_)\\w+",
    "path": "(^|\\s)[\\w./-]*/[\\w.-]+\\.[a-z]{1,5}\\b",
    "joined_token": "[A-Za-z]{3,}[0-9]{2,}[0-9A-Za-z]*",
    "stage_lead": "(?i)^(?:backlog|analysis|ready[ _]for[ _]dev(?:elopment)?|in[ _]progress|needs[ _]qa|blocked|completed|deprecated|paused|parked|active|done)\\s*(?:$|[0-9;:,.—–-])"
  },
  "plain": [
    "semicolon",
    "hex",
    "seat",
    "work_id",
    "path",
    "joined_token"
  ],
  "placeholders": [
    "todo",
    "tbd",
    "placeholder"
  ],
  "fields": {
    "goal_title": {
      "source": "lane-scoped epic title",
      "limit": 40,
      "rules": [
        "plain"
      ]
    },
    "goal_summary": {
      "source": "lane-scoped epic summary",
      "limit": 160,
      "rules": [
        "plain"
      ]
    },
    "spec_title": {
      "source": "live work item spec.md title",
      "limit": 60,
      "rules": [
        "plain"
      ]
    },
    "spec_summary": {
      "source": "live work item spec.md summary",
      "limit": 200,
      "rules": [
        "plain"
      ]
    },
    "status": {
      "source": "summary.md Status label",
      "label": "Status",
      "limit": 160,
      "rules": [
        "placeholder",
        "stage_lead",
        "plain"
      ],
      "required": "always"
    },
    "next_action": {
      "source": "summary.md Next action label",
      "label": "Next action",
      "limit": 160,
      "rules": [
        "placeholder",
        "plain"
      ],
      "required": "nonterminal"
    },
    "blockers": {
      "source": "summary.md Blockers label",
      "label": "Blockers",
      "limit": 160,
      "rules": [
        "placeholder",
        "plain"
      ],
      "required": "blocked"
    }
  },
