{
  "name": "pentacle",
  "version": "1.0.0",
  "description": "Local-first desktop client for Pentacle.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HJK6/pentacle.git"
  },
  "bugs": {
    "url": "https://github.com/HJK6/pentacle/issues"
  },
  "homepage": "https://github.com/HJK6/pentacle#readme",
  "main": "main.js",
  "scripts": {
    "build:renderer": "esbuild renderer/src/chat_core_entry.ts --bundle --format=iife --target=chrome134 --outfile=renderer/dist/chat_core.bundle.js",
    "build:cosmic-tokens": "esbuild renderer/src/cosmic_tokens_entry.ts --bundle --format=iife --target=chrome134 --outfile=renderer/dist/cosmic_tokens.bundle.js",
    "build:cosmic-components": "esbuild renderer/src/cosmic_components_entry.ts --bundle --format=iife --target=chrome134 --outfile=renderer/dist/cosmic_components.bundle.js",
    "prestart": "npm run build:renderer && npm run build:cosmic-tokens && npm run build:cosmic-components",
    "start": "electron .",
    "test": "node scripts/run-tests.js \"test/*.test.js\" \"test/*.test.ts\"",
    "build": "npm run build:renderer && electron-builder",
    "build:mac": "node scripts/build-mac.js",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:linux": "npm run build:renderer && electron-builder --linux"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1028.0",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/client-sqs": "^3.1030.0",
    "@aws-sdk/lib-dynamodb": "^3.1028.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "pentacle-chat-core": "file:./pentacle-chat-core",
    "ssh2": "^1.17.0",
    "ws": "^8.20.0",
    "chat-core": "file:./pentacle-chat-core"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "jsdom": "^24.1.3"
  },
  "build": {
    "appId": "com.example.pentacle",
    "productName": "Pentacle",
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "dir",
      "category": "Development"
    },
    "win": {
      "target": "dir"
    }
  }
}
