<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pentacle.daily-retro</string>
  <key>ProgramArguments</key>
  <array>
    <string>__RETRO_PYTHON__</string>
    <string>__RETRO_RELEASE__/services/chat-stream-v2/tools/daily_retro.py</string>
    <string>run</string><string>--config</string><string>__RETRO_CONFIG__</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__RETRO_LOG_ROOT__/daily-retro.log</string>
  <key>StandardErrorPath</key><string>__RETRO_LOG_ROOT__/daily-retro.err</string>
</dict>
</plist>
