# systemd-user unit for the chat_streamd v2 per-host ingest satellite (hostc/WSL).
#
# Install (per README.md in this dir):
#   cp pentacle-satellite.service ~/.config/systemd/user/
#   # edit the two <...> placeholders below, then:
#   loginctl enable-linger "$USER"        # so it runs without an interactive login
#   systemctl --user daemon-reload
#   systemctl --user enable --now pentacle-satellite
#
# The shared push secret is NOT committed: it is read from
# ~/.config/pentacle/satellite.env (see README). hosta's daemon must carry the
# SAME PENTACLE_EVENT_PUSH_SECRET or every push is refused `unauthorized`.
[Unit]
Description=Pentacle chat_streamd v2 ingest satellite
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# A DEDICATED checkout, not a dev worktree: auto-update runs
# `git fetch && git checkout --detach <sha>` here, so it must not disturb other work.
WorkingDirectory=__CHECKOUT__/services/chat-stream-v2
# PATH MUST include the tmux dir (/usr/bin) — a bare systemd unit can start with
# a minimal PATH, and a `tmux` that will not resolve makes discovery silently
# ingest nothing (the macOS/hostb analogue of this outage). Pin the distro path.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PENTACLE_SATELLITE_HOST=hostc
Environment=PENTACLE_SATELLITE_CHECKOUT=__CHECKOUT__
EnvironmentFile=%h/.config/pentacle/satellite.env
ExecStart=/usr/bin/python3 __CHECKOUT__/services/chat-stream-v2/satellite.py
Restart=always
RestartSec=3
# The satellite exec-restarts itself on an approved update; Restart=always also
# covers a hard crash. Do NOT set StartLimit so tight that a restart storm during
# a bad update wedges the unit — the update path already rate-limits itself.
StartLimitIntervalSec=0

[Install]
WantedBy=default.target
