<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pentacle.usage-state-collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PENTACLE_RELEASE_CHECKOUT__/services/chat-stream-v2/.venv/bin/python</string>
    <string>__PENTACLE_RELEASE_CHECKOUT__/services/chat-stream-v2/tools/collect_usage_state.py</string>
    <string>--state</string><string>__PENTACLE_USER_HOME__/.local/share/pentacle-stream/usage_state.json</string>
    <string>--shared-scripts</string><string>__PENTACLE_RELEASE_CHECKOUT__/scripts</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__PENTACLE_RELEASE_CHECKOUT__/services/chat-stream-v2/deploy/usage-probe-bin:/opt/homebrew/bin:/usr/local/bin:__PENTACLE_USER_HOME__/.local/bin:/usr/bin:/bin</string>
    <key>PENTACLE_USAGE_CLAUDE_BIN</key><string>__PENTACLE_USER_HOME__/.local/bin/claude</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>__PENTACLE_USER_HOME__/.pentacle/usage-state-collector.log</string>
  <key>StandardErrorPath</key><string>__PENTACLE_USER_HOME__/.pentacle/usage-state-collector.err</string>
</dict>
</plist>
