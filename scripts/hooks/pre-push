#!/usr/bin/env bash
#
# pre-push — refuse pushes that would put the wrong history in the wrong place.
#
# Enable it in a clone with:
#
#     git config core.hooksPath scripts/hooks
#
# It is bypassable **by design** with `git push --no-verify` — it stops
# accidents, not a determined push. What it protects (and does not):
#
#   (a) Destination name — a remote *named* `public` whose URL is not the public
#       repository (github.com/HJK6/pentacle) is REFUSED. The resolved URL is
#       always printed so you can see where a push is going.
#   (b) Explicit refspec — a bare `git push <remote>` (no refspec) or a
#       matching-branch push is REFUSED. A same-name branch refspec
#       (`git push public my-branch`) is ALLOWED: it maps to the same branch
#       name, so it cannot misroute — this check does NOT force the
#       `src:refs/heads/dst` form; a wrong branch *name* is out of its scope and
#       is instead caught (by content) in (c).
#   (c) Foreign ancestry — for a push to the public repository (matched by URL,
#       under ANY remote name or a raw URL), every root commit reachable from a
#       pushed tip must also be a root of the remote's `main`. A tip with an
#       extra root — a foreign orphan branch, OR a merge that pulls a different
#       repository's history into a clean branch — is REFUSED. If the public
#       repo's `main` cannot be resolved, the push is REFUSED (fail closed).
#       For non-public remotes the same root-set check runs when the remote's
#       `main` is resolvable, and is skipped with a note when it is not.
#
# Portability: the explicit-refspec check reads the invoking `git push` argv from
# /proc (Linux) or `ps` (macOS/BSD) — it runs everywhere those exist. `ps`
# parsing is whitespace-based and best-effort; refspecs contain no spaces. If the
# argv cannot be read at all, a push to the public repo is REFUSED (fail closed).
#
# Origin: 2026-09-12 — a private branch carrying the whole `pentacle-private`
# history (no merge base with this repo) was pushed to public `HJK6/pentacle` by
# a branch-name mixup. Bart review of 66d6d871 hardened (c) to a root-set check
# and made destination detection URL-based.

set -u

remote_name="${1:-}"
remote_url="${2:-}"
zero='0000000000000000000000000000000000000000'
fail=0

warn() { printf 'pre-push: %s\n' "$*" >&2; }

# `.git` suffix and a trailing slash are cosmetic; drop them before comparing.
canonicalize_url() { printf '%s' "${1%/}" | sed 's/\.git$//'; }

# Is this URL the public HJK6/pentacle repo (any standard form)? Extra URLs may
# be marked public for tests/mirrors via PENTACLE_ALLOWED_PUBLIC_REMOTES
# (whitespace-separated). Note: pentacle-private canonicalizes to a different
# path and is intentionally NOT matched.
is_public_url() {
  local u
  u="$(canonicalize_url "$1")"
  case "$u" in
    git@github.com:HJK6/pentacle|\
    https://github.com/HJK6/pentacle|\
    ssh://git@github.com/HJK6/pentacle|\
    git://github.com/HJK6/pentacle) return 0 ;;
  esac
  if [ -n "${PENTACLE_ALLOWED_PUBLIC_REMOTES:-}" ]; then
    local extra
    for extra in ${PENTACLE_ALLOWED_PUBLIC_REMOTES}; do
      [ "$u" = "$(canonicalize_url "$extra")" ] && return 0
    done
  fi
  return 1
}

is_public=0
if is_public_url "$remote_url"; then is_public=1; fi

# ── always show where the push is going ─────────────────────────────────────
if [ "$is_public" -eq 1 ]; then
  warn "pushing to '${remote_name}' -> ${remote_url} (public repo — public rules apply)"
else
  warn "pushing to '${remote_name}' -> ${remote_url}"
fi

# ── (a) a remote *named* `public` must resolve to the public repo ────────────
if [ "$remote_name" = "public" ] && [ "$is_public" -ne 1 ]; then
  warn "REFUSED: remote 'public' resolves to '${remote_url}', which is not the public HJK6/pentacle."
  warn "         a remote named 'public' must point at github.com/HJK6/pentacle."
  fail=1
fi

# ── (b) explicit refspec: no bare / matching-branch pushes ───────────────────
# Read the invoking `git push` argv (git runs builtins in-process, so $PPID is
# that command). Prints one token per line, or nothing if it cannot be read.
read_parent_argv() {
  if [ -r "/proc/$PPID/cmdline" ]; then
    tr '\0' '\n' < "/proc/$PPID/cmdline"
  elif command -v ps >/dev/null 2>&1; then
    ps -ww -o args= -p "$PPID" 2>/dev/null | tr ' ' '\n'
  fi
}

# Count positional (non-option) args after the `push` subcommand. Echoes the
# count, or "unknown" if the argv/`push` token could not be found.
count_push_positionals() {
  local -a argv=()
  local line
  while IFS= read -r line; do argv+=("$line"); done < <(read_parent_argv)
  [ "${#argv[@]}" -eq 0 ] && { printf 'unknown'; return; }
  local pi=-1 i
  for i in "${!argv[@]}"; do
    [ "${argv[$i]}" = "push" ] && { pi=$i; break; }
  done
  [ "$pi" -lt 0 ] && { printf 'unknown'; return; }
  local value_opts=" -o --push-option --repo --receive-pack --exec "
  local -a positionals=()
  local j=$((pi + 1)) tok
  while [ "$j" -lt "${#argv[@]}" ]; do
    tok="${argv[$j]}"
    case "$tok" in
      --) j=$((j + 1)); while [ "$j" -lt "${#argv[@]}" ]; do positionals+=("${argv[$j]}"); j=$((j + 1)); done; break ;;
      --*=*) : ;;
      -*) printf '%s' "$value_opts" | grep -q -- " ${tok} " && j=$((j + 1)) ;;
      *) positionals+=("$tok") ;;
    esac
    j=$((j + 1))
  done
  printf '%d' "${#positionals[@]}"
}

positional_count="$(count_push_positionals)"
if [ "$positional_count" = unknown ]; then
  if [ "$is_public" -eq 1 ]; then
    warn "REFUSED: could not read the invoking 'git push' to verify an explicit refspec (fail closed for the public repo)."
    fail=1
  else
    warn "note: could not read the invoking 'git push' argv; skipping the explicit-refspec check."
  fi
elif [ "$positional_count" -le 1 ]; then
  # 0 positionals = `git push`; 1 = `git push <remote>` — both lack a refspec.
  warn "REFUSED: no refspec. Push explicitly, e.g. 'git push ${remote_name} <branch>:refs/heads/<branch>'."
  warn "         a bare 'git push ${remote_name}' or a matching-branch push is not allowed."
  fail=1
fi

# ── resolve the remote's main into a local object ────────────────────────────
remote_main=''
if git rev-parse --verify --quiet "refs/remotes/${remote_name}/main" >/dev/null 2>&1; then
  remote_main="$(git rev-parse "refs/remotes/${remote_name}/main")"
fi
if [ -z "$remote_main" ] && [ -n "$remote_url" ]; then
  ls_main="$(git ls-remote --heads "$remote_url" main 2>/dev/null | awk 'NR==1{print $1}')"
  if [ -n "$ls_main" ]; then
    if git cat-file -e "${ls_main}^{commit}" 2>/dev/null; then
      remote_main="$ls_main"
    elif git fetch -q "$remote_url" main 2>/dev/null; then
      remote_main="$(git rev-parse FETCH_HEAD)"
    fi
  fi
fi

# ── (c) foreign-ancestry root-set check ──────────────────────────────────────
if [ -z "$remote_main" ]; then
  if [ "$is_public" -eq 1 ]; then
    warn "REFUSED: cannot resolve the public repo's 'main' to verify shared history (fail closed)."
    fail=1
  else
    warn "note: '${remote_name}' has no resolvable 'main'; skipping the shared-history check."
  fi
else
  # roots of the remote main = the allowed root set
  declare -A main_roots=()
  while IFS= read -r r; do [ -n "$r" ] && main_roots["$r"]=1; done < <(git rev-list --max-parents=0 "$remote_main" 2>/dev/null)
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    [ "$local_sha" = "$zero" ] && continue                    # deletion
    extra_root=''
    while IFS= read -r r; do
      [ -z "$r" ] && continue
      if [ -z "${main_roots[$r]:-}" ]; then extra_root="$r"; break; fi
    done < <(git rev-list --max-parents=0 "$local_sha" 2>/dev/null)
    if [ -n "$extra_root" ]; then
      warn "REFUSED: ${_local_ref:-<ref>} reaches a root commit (${extra_root:0:12}) that is not a root of ${remote_name}/main."
      warn "         this is foreign history — an unrelated repository's line, or a merge that pulls one in."
      fail=1
    fi
    : "$remote_sha"
  done
fi

if [ "$fail" -ne 0 ]; then
  warn "push blocked. If this is genuinely correct, re-run with 'git push --no-verify'."
  exit 1
fi
exit 0
