#!/usr/bin/env bash
#
# pre-push — refuse pushes that would put the wrong history in the wrong place.
#
# Enable it in a clone with:
#
#     git config core.hooksPath scripts/hooks
#
# It is bypassable **by design** with `git push --no-verify` — it stops
# accidents, not a determined push. What it protects (and does not):
#
#   (a) Destination — a remote *named* `public` whose URL is not the public
#       repository (github.com/HJK6/pentacle, any URL spelling) is REFUSED, and
#       the public-repo rules below apply whenever the destination URL resolves
#       to that repo under ANY remote name or a raw URL. The resolved URL is
#       always printed.
#   (b) Explicit refspec — a bare `git push <remote>` (no refspec) or a
#       matching-branch push (a `:` refspec) is REFUSED. A same-name branch
#       refspec (`git push public my-branch`) is ALLOWED: it maps to the same
#       branch name and cannot misroute — this does NOT force `src:refs/heads/dst`
#       (a wrong branch *name* is out of scope and is instead caught in (c)).
#   (c) Foreign ancestry — every root commit reachable from a pushed tip must
#       also be a root of the remote's `main`. A tip with an extra root — a
#       foreign orphan branch, OR a merge that pulls another repository's history
#       into a clean branch — is REFUSED.
#
# FAIL CLOSED. For a push to the public repo the hook REFUSES (never exit 0)
# when it cannot fully verify: no/blank/malformed push records on stdin, an
# unresolvable current `main`, or an unreadable invoking argv. It never trusts a
# possibly-stale remote-tracking ref for the public repo — it re-resolves the
# remote's `main` from the live remote (`git ls-remote`) on every invocation.
#
# Portability: written for bash 3.2 (the macOS default /bin/bash 3.2.57) — no
# associative arrays, `mapfile`, or bash-4 parameter expansions. The root-set
# comparison uses only bash builtins + `git` (no `grep`/`head`/`awk`/`sed`/`tr`
# in the decision path), so a stripped PATH cannot silently disable a check. The
# explicit-refspec check reads the invoking `git push` argv from /proc (Linux)
# or `ps` (macOS/BSD); it parses git's global options so `-C`/`-c` values cannot
# be mistaken for the subcommand.
#
# Origin: 2026-09-12 — a private branch (no merge base with this repo) was pushed
# to public `HJK6/pentacle` by a branch-name mixup. Hardened against a QA review
# (empty-stdin/tooling fail-open, stale-ref trust, argv and URL edge cases).

set -u

# ── 0. Capture stdin FIRST, before anything (a BASH_ENV startup script or any
# subshell) could consume the update records git feeds the hook. ──────────────
PREPUSH_STDIN="$(cat 2>/dev/null || true)"

remote_name="${1:-}"
remote_url="${2:-}"
zero='0000000000000000000000000000000000000000'
fail=0

warn() { printf 'pre-push: %s\n' "$*" >&2; }

# Only `git` is needed for the decision path; refuse if it is missing.
if ! command -v git >/dev/null 2>&1; then
  warn "REFUSED: 'git' not found; cannot verify this push (fail closed)."
  exit 1
fi

# ── URL classification ───────────────────────────────────────────────────────
# Does this URL address github.com/HJK6/pentacle? Handles ssh scp-like, ssh://,
# https:// and git:// forms, userinfo (user[:pass]@), an explicit or default
# port, a trailing slash, a .git suffix, and a case-insensitive host. It does
# NOT match HJK6/pentacle-private or any other path.
is_github_pentacle_url() {
  local u="$1" host path before aftercolon hostport
  [ -n "$u" ] || return 1
  case "$u" in *://*) u="${u#*://}";; esac   # drop scheme
  u="${u##*@}"                                # drop userinfo
  before="${u%%/*}"
  case "$before" in
    *:*)
      hostport="${u%%:*}"; aftercolon="${u#*:}"
      case "$aftercolon" in
        [0-9]*/*|[0-9]*) host="$hostport"; path="${u#*/}" ;;  # host:port/path
        *)               host="$hostport"; path="$aftercolon" ;; # scp host:path
      esac ;;
    *) host="${u%%/*}"; path="${u#*/}" ;;
  esac
  host="${host%%:*}"
  path="${path#/}"; path="${path%/}"; path="${path%.git}"
  case "$host" in
    [Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]) : ;;
    *) return 1 ;;
  esac
  [ "$path" = "HJK6/pentacle" ]
}

is_public=0
if is_github_pentacle_url "$remote_url"; then
  is_public=1
elif [ "${PENTACLE_PREPUSH_TEST_MODE:-}" = 1 ] && [ -n "${PENTACLE_ALLOWED_PUBLIC_REMOTES:-}" ]; then
  # Test/mirror-only escape hatch: only honored under an explicit test-mode flag,
  # announced loudly, and NEVER able to reclassify a pentacle-private lookalike.
  can_u="${remote_url%/}"; can_u="${can_u%.git}"
  case "$can_u" in
    *pentacle-private*) : ;;                  # never treat the private repo as public
    *)
      for _extra in ${PENTACLE_ALLOWED_PUBLIC_REMOTES}; do
        _e="${_extra%/}"; _e="${_e%.git}"
        if [ "$can_u" = "$_e" ]; then
          is_public=1
          warn "WARNING: treating '${remote_url}' as the public repo via PENTACLE_PREPUSH_TEST_MODE (test/mirror override)."
          break
        fi
      done ;;
  esac
fi

if [ "$is_public" -eq 1 ]; then
  warn "pushing to '${remote_name}' -> ${remote_url} (public repo — public rules apply)"
else
  warn "pushing to '${remote_name}' -> ${remote_url}"
fi

# ── (a) a remote *named* `public` must resolve to the public repo ────────────
if [ "$remote_name" = "public" ] && [ "$is_public" -ne 1 ]; then
  warn "REFUSED: remote 'public' resolves to '${remote_url}', which is not the public HJK6/pentacle."
  fail=1
fi

# ── (b) explicit refspec: no bare / matching-branch pushes ───────────────────
# Read the invoking `git push` argv ($PPID; git runs builtins in-process). Prints
# one token per line, or nothing if it cannot be read.
read_parent_argv() {
  if [ -r "/proc/$PPID/cmdline" ]; then
    tr '\0' '\n' < "/proc/$PPID/cmdline"
  elif command -v ps >/dev/null 2>&1; then
    ps -ww -o args= -p "$PPID" 2>/dev/null | tr ' ' '\n'
  fi
}

# Echo the push refspec arguments (positionals after the remote), one per line;
# echo the sentinel "__UNKNOWN__" if the argv or the `push` subcommand cannot be
# located. Git global options are parsed (incl. their separate-arg values) so a
# `-C push` value is never mistaken for the subcommand.
push_refspecs() {
  local -a argv=()
  local line
  while IFS= read -r line; do argv+=("$line"); done < <(read_parent_argv)
  [ "${#argv[@]}" -eq 0 ] && { printf '__UNKNOWN__\n'; return; }
  local global_value=" -C -c --git-dir --work-tree --namespace --super-prefix --config-env --attr-source "
  local push_value=" -o --push-option --repo --receive-pack --exec "
  local i=1 tok
  # skip git global options to find the subcommand
  while [ "$i" -lt "${#argv[@]}" ]; do
    tok="${argv[$i]}"
    case "$tok" in
      push) break ;;
      --*=*) i=$((i + 1)); continue ;;
      -*) case "$global_value" in *" $tok "*) i=$((i + 2));; *) i=$((i + 1));; esac; continue ;;
      *) printf '__UNKNOWN__\n'; return ;;   # first positional is not `push`
    esac
  done
  [ "$i" -ge "${#argv[@]}" ] && { printf '__UNKNOWN__\n'; return; }
  # now argv[i] == push; collect positionals after it (remote + refspecs)
  local -a positionals=()
  local j=$((i + 1))
  while [ "$j" -lt "${#argv[@]}" ]; do
    tok="${argv[$j]}"
    case "$tok" in
      --) j=$((j + 1)); while [ "$j" -lt "${#argv[@]}" ]; do positionals+=("${argv[$j]}"); j=$((j + 1)); done; break ;;
      --*=*) : ;;
      -*) case "$push_value" in *" $tok "*) j=$((j + 1));; esac ;;
      *) positionals+=("$tok") ;;
    esac
    j=$((j + 1))
  done
  # positionals[0] is the remote; the rest are refspecs.
  local k=1
  while [ "$k" -lt "${#positionals[@]}" ]; do printf '%s\n' "${positionals[$k]}"; k=$((k + 1)); done
}

refspec_out="$(push_refspecs)"
if [ "$refspec_out" = "__UNKNOWN__" ]; then
  if [ "$is_public" -eq 1 ]; then
    warn "REFUSED: could not read the invoking 'git push' to verify an explicit refspec (fail closed)."
    fail=1
  else
    warn "note: could not read the invoking 'git push' argv; skipping the explicit-refspec check."
  fi
else
  refspec_count=0; matching_only=1
  while IFS= read -r _rs; do
    [ -z "$_rs" ] && continue
    refspec_count=$((refspec_count + 1))
    case "$_rs" in ":") : ;; *) matching_only=0 ;; esac   # ":" alone = matching push
  done <<EOF
$refspec_out
EOF
  if [ "$refspec_count" -eq 0 ]; then
    warn "REFUSED: no refspec. Push explicitly, e.g. 'git push ${remote_name} <branch>:refs/heads/<branch>'."
    fail=1
  elif [ "$matching_only" -eq 1 ]; then
    warn "REFUSED: a matching-branch push (':') is not allowed; name what you push."
    fail=1
  fi
fi

# ── resolve the remote's main into a local commit object ─────────────────────
# For the public repo, NEVER trust a possibly-stale remote-tracking ref: resolve
# the live remote's main via ls-remote and fetch that exact commit; fail closed
# if it cannot be resolved. For other remotes, best-effort (tracking ref first).
remote_main=''
resolve_via_ls_remote() {
  local ls
  ls="$(git ls-remote --heads "$remote_url" main 2>/dev/null)"
  ls="${ls%%$'\n'*}"; ls="${ls%%$'\t'*}"; ls="${ls%% *}"
  [ -n "$ls" ] || return 1
  if git cat-file -e "${ls}^{commit}" 2>/dev/null; then
    printf '%s' "$ls"; return 0
  fi
  git fetch -q "$remote_url" main 2>/dev/null || return 1
  git rev-parse FETCH_HEAD 2>/dev/null
}

if [ "$is_public" -eq 1 ]; then
  if [ -n "$remote_url" ]; then remote_main="$(resolve_via_ls_remote || true)"; fi
  if [ -z "$remote_main" ]; then
    warn "REFUSED: cannot resolve the public repo's live 'main' to verify shared history (fail closed)."
    fail=1
  fi
else
  if git rev-parse --verify --quiet "refs/remotes/${remote_name}/main" >/dev/null 2>&1; then
    remote_main="$(git rev-parse "refs/remotes/${remote_name}/main")"
  elif [ -n "$remote_url" ]; then
    remote_main="$(resolve_via_ls_remote || true)"
  fi
fi

# ── (c) foreign-ancestry root-set check (bash-only membership) ────────────────
# A pushed tip is foreign if it reaches a root commit that is not a root of the
# remote main. Uses only `git rev-list` + bash string comparison.
sha_re='^[0-9a-f][0-9a-f]*$'
main_roots=''
if [ -n "$remote_main" ]; then
  main_roots="$(git rev-list --max-parents=0 "$remote_main" 2>/dev/null)"
  if [ -z "$main_roots" ]; then
    if [ "$is_public" -eq 1 ]; then
      warn "REFUSED: could not enumerate the public repo main's root commits (fail closed)."
      fail=1
    else
      warn "note: could not enumerate ${remote_name}/main's roots; skipping the shared-history check."
    fi
  fi
fi

records=0
while read -r _lref lsha _rref rsha; do
  [ -z "${lsha:-}" ] && continue
  case "$lsha" in
    $zero) records=$((records + 1)); continue ;;              # deletion: a real record
  esac
  case "$lsha" in [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;; *) continue ;; esac
  records=$((records + 1))
  [ -n "$main_roots" ] || continue   # nothing to compare against (non-public skip / public already failed)
  extra_root=''
  while IFS= read -r r; do
    [ -z "$r" ] && continue
    found=0
    for m in $main_roots; do [ "$r" = "$m" ] && { found=1; break; }; done
    [ "$found" -eq 0 ] && { extra_root="$r"; break; }
  done <<EOF
$(git rev-list --max-parents=0 "$lsha" 2>/dev/null)
EOF
  if [ -n "$extra_root" ]; then
    warn "REFUSED: ${_lref:-<ref>} reaches a root commit (${extra_root:0:12}) that is not a root of ${remote_name}/main."
    warn "         this is foreign history — an unrelated repository's line, or a merge that pulls one in."
    fail=1
  fi
  : "$rsha"
done <<EOF
$PREPUSH_STDIN
EOF

# Empty/blank/malformed input to a public push is a fail-closed refusal: without
# a verifiable update record the shared-history check above cannot have run.
if [ "$records" -eq 0 ] && [ "$is_public" -eq 1 ]; then
  warn "REFUSED: no verifiable push records on stdin for a public push (fail closed)."
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  warn "push blocked. If this is genuinely correct, re-run with 'git push --no-verify'."
  exit 1
fi
exit 0
