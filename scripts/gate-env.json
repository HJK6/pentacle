{
  "schema": "pentacle.gate-env.v1",
  "toolchain": {
    "python": "3.13",
    "node": "22"
  },
  "tools": {
    "tmux": {
      "exact_major_minor": {
        "darwin": "3.7",
        "linux": "3.4"
      }
    },
    "zsh": {
      "minimum": "5.9"
    },
    "lsof": "presence",
    "chrome": {
      "minimum_major": 130
    }
  },
  "umask": "022",
  "reserve_s": 60,
  "deadline": {
    "preflight_s": 45,
    "reserve_s": 60,
    "slack_s": 30,
    "merge_check_bounds_s": {
      "merge_base": 20,
      "daemon_contract": 60,
      "daemon_layer_selectors": 90,
      "daemon_b04_selectors": 90,
      "coverage": 2400
    }
  },
  "max_tmpdir_bytes": 48,
  "min_free_mb": 1024,
  "locales": [
    "en_US.UTF-8",
    "C.UTF-8"
  ],
  "system_path": [
    "/usr/bin",
    "/bin",
    "/usr/sbin",
    "/sbin"
  ],
  "search_path": {
    "darwin": [
      "/opt/homebrew/opt/python@3.13/bin",
      "/opt/homebrew/opt/node@22/bin",
      "/opt/homebrew/bin",
      "/usr/local/bin"
    ],
    "linux": [
      "/usr/local/bin",
      "/usr/bin",
      "/bin"
    ]
  },
  "capability_sets": {
    "v2_host": [
      "ps argv readable",
      "ps birth readable",
      "process start identity readable",
      "lsof descriptor readable",
      "tmux usable",
      "short-path unix-socket directory writable",
      "environment: isolated Python dependencies"
    ],
    "pytest_owner": [
      "ps birth readable",
      "process start identity readable",
      "environment: isolated Python dependencies"
    ]
  },
  "profiles": {
    "pentacle": {
      "service_dir": "services/chat-stream-v2",
      "python_requirements": [
        "services/chat-stream-v2/requirements.txt"
      ],
      "python_editable": [
        "services/agent-orch"
      ],
      "pythonpath": [
        "services",
        "services/agent-orch"
      ],
      "package_lock": "package-lock.json",
      "targets": {
        "v2-unit": {
          "kind": "run_gate",
          "gate": "unit",
          "needs": [
            "python",
            "node",
            "tmux"
          ],
          "capabilities": "v2_host",
          "timeout_s": 7000,
          "max_timeout_s": 7000,
          "unit_workers": 4
        },
        "v2-contract": {
          "kind": "run_gate",
          "gate": "contract",
          "needs": ["python", "node", "tmux"],
          "capabilities": "v2_host",
          "timeout_s": 300,
          "max_timeout_s": 300,
          "unit_workers": 2
        },
        "v2-smoke": {
          "kind": "run_gate",
          "gate": "smoke",
          "needs": [
            "python",
            "node",
            "tmux"
          ],
          "capabilities": "v2_host",
          "preflight_script": "services/chat-stream-v2/tools/gate_preflight.sh",
          "timeout_s": 600,
          "max_timeout_s": 7200
        },
        "v2-merge": {
          "kind": "run_gate",
          "gate": "merge",
          "needs": [
            "python",
            "node",
            "tmux"
          ],
          "capabilities": "v2_host",
          "preflight_script": "services/chat-stream-v2/tools/gate_preflight.sh",
          "tier_timeouts": {
            "contract": 300,
            "unit": 7000,
            "smoke": 600
          },
          "timeout_s": 7900,
          "max_timeout_s": 7900,
          "unit_workers": 4
        },
        "v2-merge-capacity": {
          "alias": "v2-merge"
        },
        "v2-pytest": {
          "kind": "pytest_files",
          "quarantine_suite": "daemon",
          "needs": [
            "python",
            "node",
            "tmux"
          ],
          "capabilities": "v2_host",
          "select": {
            "root": "services/chat-stream-v2",
            "pattern": "^tests/test_[A-Za-z0-9_]+\\.py(::[A-Za-z0-9_]+)*$"
          },
          "required_select": [
            "tests/test_capabilities.py::test_changed_test_skip_calls_are_confined_to_requires",
            "tests/test_capabilities.py::test_sigkill_reaping_remains_tracked_without_skip",
            "tests/test_capabilities.py::test_fixture_manifest_is_explicitly_synthetic_and_hash_pinned",
            "tests/test_capabilities.py::test_scope_manifest_covers_all_new_portability_tests"
          ],
          "timeout_s": 900,
          "max_timeout_s": 7200,
          "strict_capabilities": false
        },
        "v2-quarantined": {
          "kind": "pytest_files",
          "needs": ["python", "node", "tmux"],
          "capabilities": "v2_host",
          "select": {
            "root": "services/chat-stream-v2",
            "pattern": "^tests/test_[A-Za-z0-9_]+\\.py$"
          },
          "default_patterns": [],
          "quarantine_defaults": true,
          "pytest_addopts": "-m quarantined",
          "timeout_s": 120,
          "max_timeout_s": 120,
          "strict_capabilities": false
        },
        "npm-test": {
          "kind": "npm_test",
          "needs": [
            "python",
            "node",
            "npm"
          ],
          "npm_ci": true,
          "process_listing": true,
          "select": {
            "pattern": "^test/[A-Za-z0-9_./*-]+$"
          },
          "default_patterns": [
            "test/*.test.js",
            "test/*.test.ts"
          ],
          "timeout_s": 900,
          "max_timeout_s": 7200,
          "npm_build": [
            "prestart"
          ],
          "strict_capabilities": false
        },
        "v2-merge-ci": {
          "alias": "v2-merge"
        },
        "cli-pytest": {
          "kind": "pytest_files",
          "quarantine_suite": "cli",
          "pass_env": [
            "AGENT_ORCH_MEMORY_REPO"
          ],
          "needs": [
            "python",
            "tmux"
          ],
          "select": {
            "root": "services/agent-orch",
            "pattern": "^tests(?:/test_[A-Za-z0-9_]+\\.py(?:::[A-Za-z0-9_]+)*)?$"
          },
          "strict_capabilities": false,
          "timeout_s": 900,
          "max_timeout_s": 900,
          "directory_select": [
            "tests"
          ],
          "capabilities": "pytest_owner"
        },
        "shared-pytest": {
          "kind": "pytest_files",
          "quarantine_suite": "shared",
          "needs": [
            "python",
            "tmux"
          ],
          "select": {
            "root": "services/_shared",
            "pattern": "^tests(?:/test_[A-Za-z0-9_]+\\.py(?:::[A-Za-z0-9_]+)*)?$"
          },
          "strict_capabilities": false,
          "timeout_s": 900,
          "max_timeout_s": 900,
          "directory_select": [
            "tests"
          ],
          "capabilities": "pytest_owner"
        },
        "web-gate": {
          "kind": "web_gate",
          "pass_env": [
            "PENTACLE_WEB_GATE_SCENARIOS",
            "PENTACLE_WEB_GATE_CONSUMER_ROOT"
          ],
          "needs": [
            "python",
            "node",
            "npm",
            "tmux"
          ],
          "npm_ci": true,
          "npm_build": [
            "prestart",
            "build:web"
          ],
          "process_listing": true,
          "capabilities": "v2_host",
          "timeout_s": 1800,
          "max_timeout_s": 1800,
          "strict_capabilities": false
        },
        "v2-unit-ci-shard": {
          "kind": "run_gate",
          "gate": "unit",
          "needs": [
            "python",
            "node",
            "tmux"
          ],
          "capabilities": "v2_host",
          "timeout_s": 3600,
          "max_timeout_s": 3600,
          "shardable": true
        }
      }
    }
  }
}
