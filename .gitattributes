# Normalize all text files to LF in the repo and on checkout.
# Pentacle is shared across macOS and Windows/WSL; LF everywhere avoids
# spurious whole-file diffs when tools auto-convert line endings.
* text=auto eol=lf

# Explicit binary markers (don't touch these)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Stamp the commit SHA into build-sha.txt on `git archive` (how the web
# release is built), so the running build can report its version without a
# .git dir or packaged metadata. See resolveBuildSha() in main/chat_stream_client.js.
build-sha.txt export-subst
