#!/usr/bin/env python3
"""Check and update a single-user Pentacle installation."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "tools"))

from pentacle.cli import main

if __name__ == "__main__":
    raise SystemExit(main(default_install=Path(__file__).resolve().parents[1]))
