{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema/catalog.schema.json",
  "title": "Shared Memory Catalog",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "path",
      "title",
      "type",
      "status",
      "canonical",
      "updated_at",
      "tags",
      "summary",
      "related"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "path": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "canonical": {
        "type": "boolean"
      },
      "updated_at": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "related": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        }
      },
      "priority": {
        "type": "string"
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "source_path": {
        "type": "string"
      },
      "repos": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "non_repo_paths": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "specs": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "logs": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    }
  }
}
