{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema": {
      "const": "model-drop.v1"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
    },
    "updated": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https?://"
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 6
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 8
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
      },
      "minItems": 0,
      "maxItems": 6
    },
    "units": {
      "const": "mm"
    },
    "up": {
      "enum": [
        "y",
        "z"
      ]
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
          },
          "camera": {
            "type": "object",
            "properties": {
              "turn": {
                "type": "number"
              },
              "tilt": {
                "type": "number",
                "minimum": -89,
                "maximum": 89
              }
            },
            "required": [
              "turn",
              "tilt"
            ],
            "additionalProperties": false
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
                },
                "role": {
                  "enum": [
                    "print",
                    "hardware",
                    "reference"
                  ]
                },
                "material": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]*$"
                },
                "color": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "about": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
                },
                "nodes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
                  },
                  "minItems": 1
                },
                "explode": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "required": [
                "id",
                "name",
                "role",
                "material",
                "color",
                "about",
                "nodes"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "title",
          "file",
          "parts"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "schema",
    "project",
    "id",
    "title",
    "updated",
    "summary",
    "facts",
    "changes",
    "unverified",
    "units",
    "up",
    "views"
  ],
  "additionalProperties": false
}
